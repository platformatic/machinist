{
  "name": "machinist",
  "version": "2.3.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "PLT_DEV_MODE=true pnpm run start",
    "lint": "standard | snazzy",
    "lint:fix": "standard --fix",
    "start": "platformatic service start",
    "test": "node scripts/run-tests.js",
    "test:unit": "borp --concurrency=1 tests/*.test.js",
    "test:e2e:ecs": "borp --concurrency=1 tests/e2e/*.test.js",
    "test:install-crds": "kubectl apply -f https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.2.1/standard-install.yaml",
    "test:create-cluster": "k3d cluster list | grep -q plt-machinist-test || k3d cluster create plt-machinist-test",
    "test:build-image": "docker build ../.. -t platformatic/machinist-test:latest -f ../../Dockerfile.tests",
    "test:import-image": "k3d image import platformatic/machinist-test:latest -c plt-machinist-test --verbose",
    "test:compose-up": "docker compose -f ../../docker-compose.yml up -d --wait",
    "test:compose-down": "docker compose -f ../../docker-compose.yml down -v",
    "test:setup": "pnpm test:create-cluster && pnpm test:install-crds && pnpm test:build-image && pnpm test:import-image && pnpm test:compose-up",
    "test:teardown": "pnpm test:compose-down; compose=$?; k3d cluster rm plt-machinist-test; k3d=$?; exit $(( compose || k3d ))"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.1035.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1106.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1035.0",
    "@aws-sdk/client-secrets-manager": "^3.1091.0",
    "@aws-sdk/client-servicediscovery": "^3.1091.0",
    "@fastify/autoload": "^6.0.2",
    "@fastify/deepmerge": "^3.0.0",
    "@fastify/error": "^4.0.0",
    "@fastify/sensible": "^6.0.1",
    "@platformatic/service": "^3.54.0",
    "ajv": "^8.17.1",
    "fast-querystring": "^1.1.2",
    "fastify-plugin": "^5.1.0",
    "platformatic": "^3.54.0",
    "pluralize": "^8.0.0",
    "split2": "^4.2.0",
    "undici": "^8.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-ec2": "^3.1091.0",
    "aws-sdk-client-mock": "^4.1.0",
    "borp": "^1.0.0",
    "fastify": "^5.6.1",
    "snazzy": "^9.0.0",
    "standard": "^17.1.2",
    "yaml": "^2.8.1"
  },
  "packageManager": "pnpm@11.5.0"
}
